{
  "rewrites": [
    { "source": "/akce/:slug", "destination": "/api/og/:slug" },
    { "source": "/((?!api/|_vercel/|akce/).*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/t/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/ticket-sw.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/admin(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/scanner(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ],
  "crons": [
    { "path": "/api/cron/anonymize", "schedule": "0 4 * * *" }
  ]
}
